{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mormot2-monitor/analysis@1",
  "title": "mORMot2 Daily analysis payload",
  "description": "Contract Jules must satisfy when writing data/analysis/<edition>.json. The static site is generated from this file; anything outside the contract is ignored. Reader-facing text may be written once in English or once per language (en, fr, zh, ru); en is always required. Machine fields — sha, category, severity, action, units, api_changes.symbol and .change — are never translated.",
  "type": "object",
  "required": [
    "schema",
    "edition",
    "edition_title",
    "intro",
    "tldr",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "mormot2-monitor/analysis@1"
    },
    "edition": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Must match the raw payload edition date."
    },
    "edition_title": {
      "description": "Headline for the day, e.g. 'A nasty RW-lock race gets fixed'. No date, no 'mORMot2' prefix. Either a plain string (English) or an object keyed by language code: en (required), fr, zh, ru.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 8,
          "maxLength": 90
        },
        {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "string",
              "minLength": 8,
              "maxLength": 90
            },
            "fr": {
              "type": "string",
              "maxLength": 90
            },
            "zh": {
              "type": "string",
              "maxLength": 90
            },
            "ru": {
              "type": "string",
              "maxLength": 90
            }
          }
        }
      ]
    },
    "intro": {
      "description": "2-4 sentences of morning-read prose: what today's batch is about and who should care. Plain English, no bullet points, no markdown. Either a plain string (English) or an object keyed by language code: en (required), fr, zh, ru.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 120,
          "maxLength": 1200
        },
        {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "string",
              "minLength": 120,
              "maxLength": 1200
            },
            "fr": {
              "type": "string",
              "maxLength": 1200
            },
            "zh": {
              "type": "string",
              "maxLength": 1200
            },
            "ru": {
              "type": "string",
              "maxLength": 1200
            }
          }
        }
      ]
    },
    "tldr": {
      "description": "Scannable takeaways, most important first. One fact each. Either a plain string (English) or an object keyed by language code: en (required), fr, zh, ru.",
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 15,
            "maxLength": 220
          }
        },
        {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 15,
                "maxLength": 220
              }
            },
            "fr": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "string",
                "maxLength": 220
              }
            },
            "zh": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "string",
                "maxLength": 220
              }
            },
            "ru": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "string",
                "maxLength": 220
              }
            }
          }
        }
      ]
    },
    "risk_level": {
      "enum": [
        "calm",
        "worth-a-look",
        "act-now"
      ],
      "description": "Overall signal for a team running mORMot2 in production."
    },
    "upgrade_advice": {
      "description": "Should a team pull these commits today, and what to watch for. Either a plain string (English) or an object keyed by language code: en (required), fr, zh, ru.",
      "oneOf": [
        {
          "type": "string",
          "maxLength": 600
        },
        {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "string",
              "maxLength": 600
            },
            "fr": {
              "type": "string",
              "maxLength": 600
            },
            "zh": {
              "type": "string",
              "maxLength": 600
            },
            "ru": {
              "type": "string",
              "maxLength": 600
            }
          }
        }
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entry"
      }
    },
    "themes": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "title",
          "summary",
          "shas"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "object",
                "required": [
                  "en"
                ],
                "additionalProperties": false,
                "properties": {
                  "en": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "fr": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "zh": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "ru": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            ]
          },
          "summary": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 700
              },
              {
                "type": "object",
                "required": [
                  "en"
                ],
                "additionalProperties": false,
                "properties": {
                  "en": {
                    "type": "string",
                    "maxLength": 700
                  },
                  "fr": {
                    "type": "string",
                    "maxLength": 700
                  },
                  "zh": {
                    "type": "string",
                    "maxLength": 700
                  },
                  "ru": {
                    "type": "string",
                    "maxLength": 700
                  }
                }
              }
            ]
          },
          "shas": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      },
      "description": "Optional grouping when several commits tell one story (a refactor spread over 6 commits)."
    },
    "notes": {
      "description": "Anything the reviewer could not confirm, or context that did not fit elsewhere. Either a plain string (English) or an object keyed by language code: en (required), fr, zh, ru.",
      "oneOf": [
        {
          "type": "string",
          "maxLength": 600
        },
        {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "string",
              "maxLength": 600
            },
            "fr": {
              "type": "string",
              "maxLength": 600
            },
            "zh": {
              "type": "string",
              "maxLength": 600
            },
            "ru": {
              "type": "string",
              "maxLength": 600
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": [
        "sha",
        "headline",
        "category",
        "severity",
        "what_changed",
        "impact",
        "action",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "sha": {
          "type": "string",
          "minLength": 7,
          "description": "Full SHA from the raw payload. Every entry must map to a commit in that file."
        },
        "headline": {
          "description": "Rewritten in plain English for a reader who does not know the codebase. Not a copy of the commit subject. Either a plain string (English) or an object keyed by language code: en (required), fr, zh, ru.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 10,
              "maxLength": 110
            },
            {
              "type": "object",
              "required": [
                "en"
              ],
              "additionalProperties": false,
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 110
                },
                "fr": {
                  "type": "string",
                  "maxLength": 110
                },
                "zh": {
                  "type": "string",
                  "maxLength": 110
                },
                "ru": {
                  "type": "string",
                  "maxLength": 110
                }
              }
            }
          ]
        },
        "category": {
          "enum": [
            "breaking",
            "security",
            "fix",
            "feature",
            "performance",
            "deprecation",
            "refactor",
            "compat",
            "tests",
            "docs",
            "chore"
          ]
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "what_changed": {
          "description": "What the diff actually does, grounded in the code you read. Name the units, types and methods involved. Either a plain string (English) or an object keyed by language code: en (required), fr, zh, ru.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 40,
              "maxLength": 900
            },
            {
              "type": "object",
              "required": [
                "en"
              ],
              "additionalProperties": false,
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 40,
                  "maxLength": 900
                },
                "fr": {
                  "type": "string",
                  "maxLength": 900
                },
                "zh": {
                  "type": "string",
                  "maxLength": 900
                },
                "ru": {
                  "type": "string",
                  "maxLength": 900
                }
              }
            }
          ]
        },
        "impact": {
          "description": "Consequence for an existing Delphi/FPC backend using mORMot2: what breaks, what gets faster, what silently changes behaviour, or explicitly 'no impact on application code'. Either a plain string (English) or an object keyed by language code: en (required), fr, zh, ru.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 40,
              "maxLength": 900
            },
            {
              "type": "object",
              "required": [
                "en"
              ],
              "additionalProperties": false,
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 40,
                  "maxLength": 900
                },
                "fr": {
                  "type": "string",
                  "maxLength": 900
                },
                "zh": {
                  "type": "string",
                  "maxLength": 900
                },
                "ru": {
                  "type": "string",
                  "maxLength": 900
                }
              }
            }
          ]
        },
        "action": {
          "enum": [
            "none",
            "review",
            "upgrade-recommended",
            "migration-required"
          ]
        },
        "action_detail": {
          "description": "Concrete next step: what to grep for, what to test, what to change. Either a plain string (English) or an object keyed by language code: en (required), fr, zh, ru.",
          "oneOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "object",
              "required": [
                "en"
              ],
              "additionalProperties": false,
              "properties": {
                "en": {
                  "type": "string",
                  "maxLength": 500
                },
                "fr": {
                  "type": "string",
                  "maxLength": 500
                },
                "zh": {
                  "type": "string",
                  "maxLength": 500
                },
                "ru": {
                  "type": "string",
                  "maxLength": 500
                }
              }
            }
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Pascal units touched, e.g. mormot.core.threads."
        },
        "api_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "symbol",
              "change"
            ],
            "additionalProperties": false,
            "properties": {
              "symbol": {
                "type": "string",
                "maxLength": 120
              },
              "change": {
                "enum": [
                  "added",
                  "removed",
                  "renamed",
                  "signature-changed",
                  "behaviour-changed",
                  "deprecated"
                ]
              },
              "note": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 300
                  },
                  {
                    "type": "object",
                    "required": [
                      "en"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "en": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "fr": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "zh": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "ru": {
                        "type": "string",
                        "maxLength": 300
                      }
                    }
                  }
                ]
              }
            }
          },
          "description": "Public API surface moves only: published functions, types, properties. Skip private/internal churn."
        },
        "confidence": {
          "enum": [
            "confirmed",
            "interpretation"
          ],
          "description": "'confirmed' = stated by the diff or the commit message; 'interpretation' = your reading of the consequences."
        }
      }
    }
  }
}
